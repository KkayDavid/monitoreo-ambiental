# Variables de entorno para despliegue en nube
# Copiar este archivo como .env y ajustar los valores antes de desplegar.
# NUNCA subir el archivo .env al repositorio.

# Base de datos central
# En producción usar PostgreSQL. Para desarrollo local usar SQLite (valor por defecto).
DATABASE_URL=postgresql://usuario:contraseña@host:5432/zao_db

# Configuración del servidor
HOST=0.0.0.0
PORT=8000

# Ruta al archivo SQLite del nodo edge (solo aplica al módulo edge en producción)
EDGE_DB_PATH=nodo.db
